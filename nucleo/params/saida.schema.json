{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Saída de um agente Ultra",
 "description": "Formato que todo agente devolve. O ultra.py valida, consolida, faz o duelo de ofertas e monta o plano a partir dele.",
 "type": "object",
 "required": ["agente", "rodada", "veredito", "notas", "achados", "acoes"],
 "properties": {
  "agente": {"type": "string", "description": "id do agente, ex.: ultra-jobs"},
  "rodada": {"type": "integer", "minimum": 1},
  "alvo": {"type": "string", "description": "URL ou nome do que foi analisado"},
  "veredito": {
   "type": "object", "required": ["resumo", "nota_geral"],
   "properties": {
    "vende": {"enum": ["vende", "vende pouco", "nao vende", "nao se aplica"]},
    "resumo": {"type": "string", "description": "1 a 2 linhas"},
    "nota_geral": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
    "confianca": {"enum": ["alta", "media", "baixa"]},
    "mudaria_com": {"type": "string", "description": "o dado que mudaria o veredito"}
   }
  },
  "notas": {
   "type": "array", "description": "uma por critério do agente (ids expandidos, ex.: oferta.garantia ou jobs.corte)",
   "items": {"type": "object", "required": ["criterio", "nota", "evidencia", "marca"],
    "properties": {"criterio": {"type": "string"}, "nota": {"type": ["number", "null"], "minimum": 0, "maximum": 10}, "evidencia": {"type": "string"}, "marca": {"enum": ["TESTADO", "EVIDENCIA", "HIPOTESE"]}}}
  },
  "achados": {
   "type": "array",
   "items": {"type": "object", "required": ["tipo", "texto", "prova", "marca"],
    "properties": {"tipo": {"enum": ["acusacao", "forca", "risco", "corte", "rebaixado", "fica", "ninguem_viu"]}, "texto": {"type": "string"}, "prova": {"type": "string"}, "custo": {"type": "string"}, "marca": {"enum": ["TESTADO", "EVIDENCIA", "HIPOTESE"]}, "gravidade": {"enum": ["alta", "media", "baixa"]}}}
  },
  "acoes": {
   "type": "array",
   "items": {"type": "object", "required": ["titulo", "impacto", "facilidade", "evidencia", "porque", "metrica"],
    "properties": {"titulo": {"type": "string"}, "etapa": {"enum": ["tecnico", "oferta", "site", "aquisicao", "vendas", "identidade", "instagram", "conteudo", "produto", "outro"]}, "semana": {"type": "integer"}, "dono": {"type": "string"}, "impacto": {"type": "number", "minimum": 1, "maximum": 10}, "facilidade": {"type": "number", "minimum": 1, "maximum": 10}, "evidencia": {"enum": ["TESTADO", "EVIDENCIA", "HIPOTESE"]}, "porque": {"type": "string"}, "passos": {"type": "array", "items": {"type": "string"}}, "entregavel": {"type": "string"}, "metrica": {"type": "string"}, "meta": {"type": "string"}}}
  },
  "temas": {"type": "object", "description": "fundadores: resposta curta para cada um dos 5 temas"},
  "ofertas": {"type": "array", "description": "conselho de vendas, rodada 1: formato_oferta da biblioteca 'oferta'"},
  "votos": {
   "type": "array", "description": "conselho de vendas, rodada 2",
   "items": {"type": "object", "required": ["oferta_id", "notas"], "properties": {"oferta_id": {"type": "string"}, "notas": {"type": "object", "description": "criterio -> nota 0..10, ex.: {'oferta.garantia': 8, 'preco.ancora': 6}"}, "roubaria": {"type": "string"}, "comentario": {"type": "string"}}}
  },
  "entregas": {
   "type": "array", "description": "marketing: entregas prontas das etapas que o agente é dono",
   "items": {"type": "object", "required": ["etapa", "tipo", "titulo"], "properties": {"etapa": {"type": "string"}, "tipo": {"enum": ["copy", "headlines", "bio", "destaques", "posts", "paleta", "tipografia", "brief_logo", "posicionamento", "canais", "testes", "roteiro", "email", "ideias_conteudo", "funil_vendas", "outro"]}, "titulo": {"type": "string"}, "texto": {"type": "string"}, "cores": {"type": "array"}, "itens": {"type": "array"}}}
  },
  "perguntas": {"type": "array", "items": {"type": "object", "required": ["para", "pergunta"], "properties": {"para": {"type": "string"}, "pergunta": {"type": "string"}}}},
  "discorda_de": {"type": "array", "items": {"type": "object", "properties": {"agente": {"type": "string"}, "ponto": {"type": "string"}, "porque": {"type": "string"}}}},
  "nao_testei": {"type": "array", "items": {"type": "string"}}
 }
}
